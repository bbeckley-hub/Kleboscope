include README.md
include LICENSE
include requirements.txt
include CITATION.cff
include environment.yml
include setup.py
include meta.yaml

# Include all Kleboscope package files
recursive-include kleboscope **
# Standard exclusions
global-exclude __pycache__
global-exclude *.pyc
global-exclude *.pyo
global-exclude *~
global-exclude .DS_Store
